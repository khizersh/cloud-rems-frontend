# Copy to .env.production on the server (never commit real values).

# Where demo and contact submissions are forwarded as JSON (CRM, Zapier/Make/n8n, email relay).
# If empty, submissions are only written to the server log (journalctl).
LEAD_WEBHOOK_URL=

# Optional: sent to the webhook as "Authorization: Bearer <value>".
LEAD_WEBHOOK_SECRET=
